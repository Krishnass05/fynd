# Copy to .env.local. Never commit .env.local.
# Without the two Supabase lines below, data stays in server memory (it resets on restart): fine for development.
# With them, the app stores everything in Supabase. Run supabase/schema.sql first. See docs/DEPLOY.md.
NEXT_PUBLIC_SUPABASE_URL=
# The service key is secret: only here and in the Vercel settings, never in the repo, git or the browser.
SUPABASE_SERVICE_ROLE_KEY=
# STORE=memory   forces in-memory data even when the Supabase lines are filled in
# ALLOW_RESET=true   lets /api/reset wipe the data in production. Leave it OFF on the live site.


# Optional AI second check for chat and calls. With no key only the rule-based guard runs.
# Free: a Google Gemini key from https://aistudio.google.com (keep it in .env.local, never commit it).
GEMINI_API_KEY=
# Or an Anthropic key (paid): ANTHROPIC_API_KEY=
# AI_GUARD_PROVIDER=gemini   (gemini, anthropic, or off)
# AI_GUARD_MODEL=            (leave empty for the default)

# Sign in with Google (optional; the Google buttons are disabled without these). See docs/AUTH.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the site lives (used for the Google redirect). Leave empty on localhost.
APP_URL=
# Signs the session cookie. Set a long random value when deployed; without it everyone is signed out on each restart.
SESSION_SECRET=
